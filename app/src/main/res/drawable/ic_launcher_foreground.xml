<?xml version="1.0" encoding="utf-8"?>
<!--
  La capa de delante: **una perilla**, en el ámbar del acento (`EmberPrimary`, #FF7A1A).

  ⚠️ El arco no es decorativo: son **270° empezando en 135°**, con el hueco abajo — exactamente el
  mismo recorrido que dibuja `KnobDial` dentro de la app (`KNOB_START_DEGREES` /
  `KNOB_SWEEP_DEGREES`, `ui/screens/Controls.kt`). El ícono es el control que hay dentro.

  Todo cabe en la zona segura de 72 dp centrada (radio 36 desde 54,54): el elemento más externo es
  el arco, de radio 22. Dibujado a mano; ni un byte de `reference/` (CLAUDE.md §7).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- El cuerpo de la perilla, en el gris de `surfaceVariant`. -->
    <path
        android:fillColor="#232629"
        android:pathData="M37,54 A17,17 0 1 1 71,54 A17,17 0 1 1 37,54z" />
    <path
        android:pathData="M37,54 A17,17 0 1 1 71,54 A17,17 0 1 1 37,54z"
        android:strokeColor="#3A3F44"
        android:strokeWidth="1.5" />

    <!-- El recorrido: 135° -> 405°, hueco abajo. -->
    <path
        android:pathData="M38.44,69.56 A22,22 0 1 1 69.56,69.56"
        android:strokeColor="#FF7A1A"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- La aguja, a las dos en punto. -->
    <path
        android:pathData="M57.5,50.5 L66,42"
        android:strokeColor="#FF7A1A"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
